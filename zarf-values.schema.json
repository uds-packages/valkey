    "uds-valkey-config": {
      "additionalProperties": false,
      "description": "Deploy-time overrides for the UDS Valkey configuration chart.",
      "properties": {
        "additionalNetworkAllow": {
          "description": "Additional UDS network-policy allow rules for workloads that need to reach Valkey.",
          "items": {
            "properties": {
              "description": {
                "type": "string"
              },
              "direction": {
                "enum": [
                  "Egress",
                  "Ingress"
                ],
                "type": "string"
              },
              "port": {
                "maximum": 65535,
                "minimum": 1,
                "type": "integer"
              },
              "remoteGenerated": {
                "type": "string"
              },
              "remoteNamespace": {
                "type": "string"
              },
              "remoteSelector": {
                "type": "object"
              },
              "selector": {
                "type": "object"
              },
              "service": {
                "type": "string"
              }
            },
            "required": [
              "direction"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "ambient": {
          "description": "Use ambient service-mesh mode instead of sidecar mode.",
          "type": "boolean"
        },
        "copyPassword": {
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "then": {
                "required": [
                  "namespace",
                  "secretKey",
                  "secretName"
                ]
              }
            }
          ],
          "description": "Copy the generated Valkey password into another namespace.",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "namespace": {
              "maxLength": 63,
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
              "type": "string"
            },
            "secretKey": {
              "pattern": "^[A-Za-z0-9._-]+$",
              "type": "string"
            },
            "secretName": {
              "maxLength": 253,
              "pattern": "^[a-z0-9]([-.a-z0-9]*[a-z0-9])?$",
              "type": "string"
            }
          },
          "type": "object"
        },
        "replicas": {
          "description": "Number of replicated Valkey nodes for which the UDS chart creates mesh resources.",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
